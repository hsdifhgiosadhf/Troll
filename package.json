{
  "name": "web-gioi-thieu-thanh-hoang",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --port 4173 --host 127.0.0.1",
    "kiemtrakieu": "node node_modules/typescript/bin/tsc --noEmit",
    "soatma": "node node_modules/eslint/bin/eslint.js .",
    "kiemthu": "node node_modules/vitest/vitest.mjs run",
    "kiemthu:e2e": "node node_modules/@playwright/test/cli.js test",
    "kiemtradungluong": "node scripts/saoluu.mjs kiemtradungluong",
    "kiemtratatca": "npm run kiemtrakieu && npm run soatma && npm run kiemthu && npm run build && npm run kiemtradungluong && npm run kiemthu:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.0.0"
  }
}
